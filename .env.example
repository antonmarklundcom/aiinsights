# Neon Postgres connection string (get from neon.tech project dashboard)
DATABASE_URL=

# Anthropic API key (console.anthropic.com) — used to summarize saved items
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Random string you invent — Telegram sends it back on every webhook call so
# you can verify requests actually came from Telegram. Any long random value.
TELEGRAM_WEBHOOK_SECRET=

# Your personal Telegram numeric chat id, so only you can use the bot.
# Leave empty while testing; fill in once you know it (see README).
TELEGRAM_ALLOWED_CHAT_ID=

# Optional: raises GitHub's unauthenticated API rate limit when fetching
# READMEs for linked repos. A classic PAT with no scopes is enough.
GITHUB_TOKEN=
