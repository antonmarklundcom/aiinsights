# ── Required in every environment ───────────────────────────────────────────

# Neon Postgres pooled connection string (neon.tech project dashboard).
DATABASE_URL=

# Anthropic API key (console.anthropic.com) — used to summarize saved items.
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# ── Required in production, optional locally ────────────────────────────────
# Missing locally is a warning, not a crash, so you can run the dashboard
# without a bot. Missing in production throws at startup.

# Random string you invent — Telegram sends it back on every webhook call so
# the route can verify the request really came from Telegram.
# Generate with: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Your personal Telegram numeric chat id, so only you can use the bot.
# See the README for how to read it off getUpdates.
TELEGRAM_ALLOWED_CHAT_ID=

# The single shared password for the dashboard (there are no user accounts).
DASHBOARD_PASSWORD=

# Secret the Vercel cron route requires as `Authorization: Bearer <value>`
# before it will retry stuck items. Generate with: openssl rand -hex 24
CRON_SECRET=

# Key used to sign the dashboard session cookie. Changing it logs you out.
# Generate with: openssl rand -hex 32
AUTH_COOKIE_SECRET=

# ── Optional ───────────────────────────────────────────────────────────────

# Raises GitHub's unauthenticated API rate limit when fetching READMEs for
# linked repos. A classic PAT with no scopes is enough.
GITHUB_TOKEN=
